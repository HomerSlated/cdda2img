# cdda2img configuration
# Copy to $XDG_CONFIG_HOME/cdda2img/cdda2img.toml
# (default: ~/.config/cdda2img/cdda2img.toml)

# CDDB server for disc metadata lookup (host:port).
# Default: cddb.retrobridge.org:888
# cddb_server = "cddb.retrobridge.org:888"

# Contact email for MusicBrainz API User-Agent (required by MusicBrainz terms of service).
# Without this, MusicBrainz lookups may be rate-limited or blocked.
# contact_email = "you@example.com"

# Number of rotating drive-offset database backups to keep (0 = disabled).
# Default: 3
# database_backups = 3

# Minimum interval between drive-offset database backups: Nd (days), Nw (weeks), Nmo (months).
# Default: 4w
# database_backup_frequency = "4w"

# Number of rotating disc catalogue backups to keep (0 = disabled).
# Backups are triggered by write access (registration after rip/import/create).
# Default: 3
# catalogue_backups = 3

# Minimum interval between disc catalogue backups: Nd (days), Nw (weeks), Nmo (months).
# Default: 1d
# catalogue_backup_frequency = "1d"

# Disc catalogue database path.
# Default: $XDG_DATA_HOME/cdda2img/cdda2img.db
# catalogue_path = "/path/to/cdda2img.db"

# Set to false to disable automatic catalogue registration after rip/import/create.
# Default: true
# enable_catalogue = true

# Default CD drive device used when no --device argument is supplied.
# Default: /dev/sr0
# default_device = "/dev/sr0"

# Silence detection threshold for the `create` pipeline's remaster mode, in -dBFS
# (absolute value; lower number = stricter trim). Audio below this level at the
# head and tail of each track is removed before the 2 s inter-track gap is added.
# Useful range: 40 (loose) … 70 (strict). Range: 1–90.
# Default: 55
# silence = 55

# Disc capacity in minutes for the `create` pipeline batcher.
# 80 = standard "700 MB" CD-R; 90 = "900 MB" media exists; overburn beyond
# nominal capacity is possible on some drive/media combinations. Range: 1–99.
# Default: 80
# capacity = 80

# Play track 1 on a loop in the background during the `rip` pipeline.
# Best-effort cosmetic preview; never blocks or fails the rip.
# Default: true
# preview = true

# Use the terminal UI for live progress rendering (currently `rip` only;
# `create` / `import` will follow). When false, progress falls back to plain
# stdout. No-op when stdin is not a TTY (CI, pipes, etc.).
# Default: true
# tui = true

# Per-drive read and write offsets.
# read_offset is stored automatically after AccurateRip confirmation.
# write_offset is stored automatically by tools/measure_write_offset.py.
# You can also add entries manually:
#
# [[drives]]
# name = "PLEXTOR DVDR PX-716A"
# read_offset = 30
# write_offset = -30
