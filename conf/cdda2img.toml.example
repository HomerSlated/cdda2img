# cdda2img configuration
# Copy to $XDG_CONFIG_HOME/cdda2img/cdda2img.toml
# (default: ~/.config/cdda2img/cdda2img.toml)

# CD drive read offset in samples (4 bytes per sample, stereo).
# Find your drive at https://www.accuraterip.com/driveoffsets.htm
# Default: 0 (no offset correction)
drive_offset = 30

# CDDB server for disc metadata lookup (host:port).
# Default: cddb.retrobridge.org:888
# cddb_server = "cddb.retrobridge.org:888"

# Number of rotating database backups to keep (0 = disabled).
# Default: 3
# database_backups = 3

# Minimum interval between database backups: Nd (days), Nh (hours), Nm (minutes).
# Default: 1d
# database_backup_frequency = "1d"

# Per-drive read offset, stored automatically after AccurateRip confirmation.
# You can also add entries manually:
#
# [[drives]]
# name = "PLEXTOR DVDR PX-716A"
# offset = 30
