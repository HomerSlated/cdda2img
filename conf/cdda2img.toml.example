# cdda2img configuration
# Copy to $XDG_CONFIG_HOME/cdda2img/cdda2img.toml
# (default: ~/.config/cdda2img/cdda2img.toml)

# CDDB server for disc metadata lookup (host:port).
# Default: gnudb.gnudb.org:8880
# cddb_server = "gnudb.gnudb.org:8880"

# Contact email for MusicBrainz API User-Agent (required by MusicBrainz terms of service).
# Without this, MusicBrainz lookups may be rate-limited or blocked.
# contact_email = "you@example.com"

# Number of rotating drive-offset database backups to keep (0 = disabled).
# Default: 3
# database_backups = 3

# Minimum interval between drive-offset database backups: Nd (days), Nw (weeks), Nmo (months).
# Default: 4w
# database_backup_frequency = "4w"

# Number of rotating disc catalogue backups to keep (0 = disabled).
# Backups are triggered by write access (registration after rip/import/create).
# Default: 3
# catalogue_backups = 3

# Minimum interval between disc catalogue backups: Nd (days), Nw (weeks), Nmo (months).
# Default: 1d
# catalogue_backup_frequency = "1d"

# Disc catalogue database path.
# Default: $XDG_DATA_HOME/cdda2img/cdda2img.db
# catalogue_path = "/path/to/cdda2img.db"

# Set to false to disable automatic catalogue registration after rip/import/create.
# Default: true
# enable_catalogue = true

# What to do when a disc matching an existing catalogue entry is registered.
# "ask"     — prompt interactively (default; falls back to "skip" without a TTY)
# "skip"    — silently abort registration if a matching row already exists
# "replace" — delete the existing row(s) and insert the new one
# "add"     — always insert, allowing multiple entries for the same disc
# Can be overridden per-run with --duplicate skip|replace|add on rip/import/create.
# Default: "ask"
# duplicate_catalogue_entry = "ask"

# Preferred release country, as an ordered priority ranking used by the
# release-selection step when MusicBrainz returns several pressings of the same
# album that the disc/ISRC data cannot tell apart. This is NOT a filter: listed
# codes rank in the order given, any unlisted country shares the lowest rank, and
# it only breaks ties *within* the same barcode tier (barcode plurality wins
# first). Leave unset/empty to skip the country preference entirely. Codes are
# ISO-3166 alpha-2, plus MusicBrainz pseudo-codes "XE" (Europe) / "XW" (Worldwide).
# preferred_country = ["GB", "XE", "US"]

# Default CD drive device used when no --device argument is supplied.
# Default: /dev/sr0
# default_device = "/dev/sr0"

# Silence detection threshold for the `create` pipeline, in -dBFS (absolute
# value; lower number = stricter trim). Audio below this level at the head and
# tail of each track is removed before the 2 s inter-track gap is added.  Only
# applied when `--silence trim` is in effect.
# Useful range: 40 (loose) … 70 (strict). Range: 1–90.
# Default: 55
# silence_threshold = 55

# Disc capacity in minutes for the `create` pipeline batcher.
# 80 = standard "700 MB" CD-R; 90 = "900 MB" media exists; overburn beyond
# nominal capacity is possible on some drive/media combinations. Range: 1–99.
# Default: 80
# capacity = 80

# Play track 1 on a loop in the background during the `rip` pipeline.
# Best-effort cosmetic preview; never blocks or fails the rip.
# Default: true
# preview = true

# Use the terminal UI for live progress rendering (rip, create, import).
# When false, output falls back to plain stdout without screen-clearing.
# No-op when stdin is not a TTY (CI, pipes, etc.).
# Default: true
# tui = true

# Album EBU R128 loudness range (LU) below which the disc is flagged
# `low_dynamic_range = YES`. The flag is recorded in the RBI provenance block
# and the catalogue. The default of 5.0 LU corresponds to a heavily compressed
# master — adjust upward for stricter classification. Range: 0.5–20.0.
# Default: 5.0
# low_dr_threshold = 5.0


# Skip the interactive metadata confirmation menu on rip/import/create.
# The pipeline still fetches and applies all metadata (CDDB, MusicBrainz,
# AcoustID, Discogs); the menu is simply bypassed and the best-guess result
# is accepted automatically. Equivalent to always passing --auto.
# Default: false
# auto = false

# Embed cover art as a PICTURE block in each extracted FLAC (~600 px JPEG).
# Modifier for --tracks/--all in the extract pipeline. Can also be set per-run
# via 'cdda2img extract --embedart'. Default: false
# embedart = false

# AccurateRip recovery effort for a rip. When a track fails AccurateRip it is
# re-read across the drive's own admitted speed ladder (fastest to slowest),
# AR-verifying each attempt and stopping at the first match. recovery_passes is how
# many full sweeps of the ladder to try per failed track before giving up (total
# attempts = passes x ladder steps). 0 disables the laddered recovery. Default: 3
# recovery_passes = 3

# Recovery profile used when neither --profile nor any --ad-* flag is given. A
# profile is a complete recovery specification, named after the strategy the bench
# measured. `cdda2img rip --list-profiles` shows what is installed; the shipped set
# is track-ladder, track-constant, max-variation, whole-disc, and the experimental
# sector-runup / sector-hammer / span-fixed. Unset falls through to the built-in
# "track-ladder" -- 19/20 across 8 bench targets, and the only arm that managed 3/3
# at the hardest one. Default: unset
# default_profile = "track-ladder"

# C2-erasure-assisted CTDB recovery. The drive's C2 error pointers can be fed to the
# ctanalyse Reed-Solomon repair as erasures, which roughly doubles how much damage it
# can reconstruct. C2 is only a *modifier* to ctanalyse, so "off" never disables
# recovery -- it just skips the erasure boost (error-only ctanalyse, then the speed
# ladder). "auto" uses C2 only when the drive both advertises and functionally
# supports it; "on" forces it; "off" never uses it. Default: auto
#
# "off" costs almost nothing to reverse and buys almost nothing: C2 pointers are
# requested on the wire on EVERY read regardless of this setting (the CLI sets
# ACCUDISC_C2_PTRS unconditionally, and the binding matches it), so the sector is
# 2646 bytes either way and the read takes exactly as long. All "off" skips is
# WRITING the bitmap to a scratch file -- about 48 MB per disc, deleted with the
# rest of the temp directory. Set it "off" only if that scratch write is itself
# the problem.
# c2_recovery = "auto"

# Per-drive read and write offsets.
# read_offset is stored automatically after AccurateRip confirmation.
# write_offset is stored automatically by `cdda2img setup --write-offset`.
# You can also add entries manually:
#
# [[drives]]
# name = "PLEXTOR DVDR PX-716A"
# read_offset = 30
# write_offset = -30
